{
  "name": "bid-evidence-agent-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Synthetic portfolio demo of an evidence-first Agent workspace",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src *.json vite.config.ts README.md docs/*.md .github/workflows/*.yml",
    "prebuild": "node scripts/sync-demo.mjs",
    "predev": "node scripts/sync-demo.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "prettier": "3.9.0"
  }
}
